# Local development (Docker Compose PostgreSQL)
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=gradebook

# Production (Supabase) — fill these in after creating your Supabase project
DATABASE_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres
SUPABASE_JWT_ISSUER_URI=https://<project-ref>.supabase.co/auth/v1
